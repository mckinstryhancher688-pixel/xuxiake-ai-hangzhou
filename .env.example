# 复制成 .env.local 后填真实值。这些变量只在服务端读取，任何一个都不带 NEXT_PUBLIC_ 前缀，
# 因此不会进浏览器包；.env.local 已被 .gitignore 忽略，不要提交。

# ── 飞猪 FlyAI CLI ────────────────────────────────────────────────
# 服务端 spawn flyai search-poi 时用；.env.local 里的值优先于继承来的进程环境。
FLYAI_API_KEY=

# ── 高德「Web 服务」Key（restapi.amap.com，服务端调用）────────────
AMAP_WEB_KEY=

# ── 高德「Web 端 (JS API)」Key（真实底图，浏览器加载）──────────────
# 必须是 JS API 类型的 Key，与上面的 Web 服务 Key 分开申请、分开配置；
# 用 Web 服务 Key 冒充会得到 USERKEY_PLAT_NOMATCH，地图退回手绘示意底图并明确标注。
AMAP_JS_KEY=

# ── 高德 JS API 安全密钥（jscode）─────────────────────────────────
# 只在服务端 /amap-proxy 里补进请求，浏览器永远拿不到；不要写成 NEXT_PUBLIC_。
AMAP_JS_SECURITY_CODE=

# ── 阿里云百炼 Managed Agents ─────────────────────────────────────
# 宿主地址形如 ws-xxxx.cn-beijing.maas.aliyuncs.com，Key 用 sk-ws- 开头的工作空间密钥。
DASHSCOPE_API_KEY=
BAILIAN_WORKSPACE_ID=
BAILIAN_AGENT_ID=
BAILIAN_ENV_ID=

# ── 可选项 ────────────────────────────────────────────────────────
# 百炼 Agent 所在区域，默认 cn-beijing；不在北京时才需要设。
# BAILIAN_REGION=cn-beijing
# 飞猪 CLI 是项目依赖，正常不需要管；只有把它装到全局时才指向那个 node_modules。
# FLYAI_CLI_ROOT=
